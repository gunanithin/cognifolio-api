# Cognifolio API Backend Configuration Template
# Copy this file to .env and populate with your credentials

# Application
APP_NAME=Cognifolio API
DEBUG=true
PORT=8000

# Google Gemini AI & Embedding Model
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# Supabase PostgreSQL Relational Database
# Format: postgresql+psycopg2://user:password@host:port/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Qdrant Vector Database (Cloud or Local)
QDRANT_LOCATION=https://YOUR_CLUSTER_ID.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=cognifolio_embeddings

# Document Storage (Google Cloud Storage / Local)
STORAGE_PROVIDER=gcs
GCS_BUCKET_NAME=your_gcs_bucket_name_here
GCS_PROJECT_ID=your_gcp_project_id_here
# Local Dev: Path to service account key file
GCS_CREDENTIALS_FILE=./gcp-credentials.json
# Cloud Deploys (Render/Railway): Paste service account JSON as environment variable string
# GCS_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
DEFAULT_RETENTION_DAYS=90
